#!/bin/sh
set -eu

HASH_FILE='/etc/kemofi/root-password-hash'

# No password was requested for this build.
[ -s "$HASH_FILE" ] || exit 0

HASH="$(sed -n '1p' "$HASH_FILE")"
CURRENT="$(awk -F: '$1 == "root" { print $2; exit }' /etc/shadow 2>/dev/null || true)"

# Set the build-time default only on a fresh image. Preserve an existing root
# credential during sysupgrade so an upgrade cannot unexpectedly replace it.
case "$CURRENT" in
    ''|'!'|'*')
        if [ -n "$HASH" ] && grep -q '^root:' /etc/shadow; then
            sed -i "s|^root:[^:]*:|root:$HASH:|" /etc/shadow
        fi
        ;;
esac

# Do not leave even the password hash in the running router after first boot.
rm -f "$HASH_FILE"
exit 0
